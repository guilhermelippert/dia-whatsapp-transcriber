# Copy to .env.local; NEVER commit that file. Real secrets belong only on the server.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=
OPENROUTER_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=Dia <no-reply@your-domain.invalid>
SUPPORT_EMAIL=support@your-domain.invalid
PUBLISHER_NAME=
PUBLIC_BASE_URL=http://127.0.0.1:43110
EXTENSION_ORIGINS=
DATABASE_PATH=./data/dia.sqlite
HOST=127.0.0.1
PORT=43110
NODE_ENV=development
TRIAL_DAYS=14
FREE_MONTHLY_ACTIONS=30
AI_REQUESTS_PER_MINUTE=20
GLOBAL_AI_CONCURRENCY=12
TRANSCRIPTION_MODEL=openai/whisper-large-v3
SUMMARY_MODEL=google/gemini-2.5-flash-lite
# Only exact IPs of a proxy you control, which overwrites X-Real-IP.
TRUSTED_PROXY_IPS=
# BRL cents; change before first production setup.
PRO_MONTHLY_AMOUNT=2990
