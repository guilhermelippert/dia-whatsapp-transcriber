# Copie para .env.local. O provedor padrão executa o whisper.cpp localmente.
TRANSCRIPTION_PROVIDER=local
PORT=43110

# Em chrome://extensions, copie o ID da extensão instalada e use a origem
# chrome-extension://<id>, sem barra final. Separe várias origens por vírgula.
ALLOWED_EXTENSION_ORIGINS=

# No modo local, informe caminhos absolutos da sua máquina.
WHISPER_CLI_PATH=
# Exemplo de localização no projeto: models/ggml-base.bin (use o caminho absoluto).
WHISPER_MODEL_PATH=
FFMPEG_PATH=

# Para usar o OpenRouter, selecione openrouter em TRANSCRIPTION_PROVIDER
# e preencha a chave abaixo. SUMMARY_MODEL configura o modelo de resumo.
OPENROUTER_API_KEY=
SUMMARY_MODEL=google/gemini-2.5-flash-lite
