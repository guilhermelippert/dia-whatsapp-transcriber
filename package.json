{
  "name": "dia-whatsapp-transcriber",
  "version": "0.4.0",
  "private": true,
  "description": "Extensão Chromium/Dia para transcrever áudios do WhatsApp Web via OpenRouter.",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "fixture": "node scripts/serve-fixture.mjs",
    "check": "node scripts/check.mjs",
    "lint:extension": "node scripts/validate-manifest.mjs",
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --release",
    "preflight": "node scripts/preflight.mjs",
    "stripe:setup": "node scripts/setup-stripe.mjs",
    "test:browser": "node scripts/browser-test.mjs"
  },
  "engines": {
    "node": ">=22.16.0 <23"
